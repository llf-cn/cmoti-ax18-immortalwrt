global {
    # 本机发起的流量：跟随最低 metric 的 IPv4 默认路由
    wan_interface: auto

    # 局域网转发流量。用 AX18 的 LAN 桥名，改过网络配置请同步修改
    lan_interface: br-lan

    data_dir: '/var/lib/honk'
    log_level: info

    # 用域名而不是 IP 发起连接，配合路由规则里的 domain 匹配
    dial_mode: domain

    # 允许 honk 按需调整内核参数（sysctl / rp_filter 等）
    auto_config_kernel_parameter: true
}

# 默认全部直连：启用本文件不会改变任何流量的走向，
# 确认 datapath 正常后再逐步加 node / group / routing 规则。
routing {
    fallback: direct
}
