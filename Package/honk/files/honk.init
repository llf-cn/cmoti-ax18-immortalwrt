#!/bin/sh /etc/rc.common
# honk 的 procd 服务脚本
#
# 默认不启用（安装后 /etc/rc.d 下没有链接）。确认 /etc/honk/config.dae 可用后再：
#   /etc/init.d/honk enable && /etc/init.d/honk start
#
# honk 会接管流量（TCX hook / cgroup sock_ops / 可选 NFQUEUE），首次部署请保留带外通道。

START=95
STOP=05
USE_PROCD=1

PROG=/usr/sbin/honk-core
CONF=/etc/honk/config.dae

start_service() {
	[ -x "$PROG" ] || { echo "honk: $PROG not found"; return 1; }
	[ -f "$CONF" ] || { echo "honk: $CONF not found"; return 1; }

	procd_open_instance
	procd_set_param command "$PROG" -c "$CONF" --disable-timestamp
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param file "$CONF"
	procd_close_instance
}

# 停止不自定义：procd 发 SIGTERM 即可，honk 会先关 admission 再拆 hook / NFQUEUE。
# 千万不要用 kill -9，否则 TC hook 和 NFQUEUE 320 可能残留在内核里。

reload_service() {
	# honk 自带 reload 子命令，通知运行中的实例按配置文件重载
	"$PROG" reload 2>/dev/null || restart
}
